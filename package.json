{
  "name": "findmy-sdk",
  "version": "1.0.3",
  "description": "Minimal TypeScript SDK for Apple's Find My network — locate, ring, mark lost, and erase your Apple devices.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ilyassesalama/findmy-sdk.git"
  },
  "homepage": "https://findmy.ilyasse.dev",
  "bugs": {
    "url": "https://github.com/ilyassesalama/findmy-sdk/issues"
  },
  "packageManager": "pnpm@12.9.1",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "pnpm build && pnpm --filter site typecheck",
    "dev": "pnpm build && pnpm --filter site dev",
    "site:build": "pnpm build && pnpm --filter site build",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "apple",
    "icloud",
    "find-my",
    "findmy",
    "location",
    "device-tracking"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "typescript": "^5.5.0"
  }
}
